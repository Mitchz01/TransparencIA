# Google AI Studio API key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# 1 = sample plan without calling Gemini (turns on by itself when there's no key)
MOCK_AGENTS=0
DATABASE_URL=sqlite:///./agile.db
CORS_ORIGINS=http://localhost:5173
# GitHub token (PAT) for issues/PRs; without a token an in-memory fake CodeHost is used
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
MOCK_GITHUB=0
