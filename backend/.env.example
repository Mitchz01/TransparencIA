# API key de Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# 1 = plan de ejemplo sin llamar a Gemini (se activa solo si no hay key)
MOCK_AGENTS=0
DATABASE_URL=sqlite:///./agile.db
CORS_ORIGINS=http://localhost:5173
# Token de GitHub (PAT) para issues/PRs; sin token se usa un CodeHost falso en memoria
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
MOCK_GITHUB=0
